# Postgres (ex.: Neon, Supabase, Vercel Postgres)
DATABASE_URL=postgres://usuario:senha@host:5432/banco
# use "disable" apenas em Postgres local
DB_SSLMODE=require

# Chave longa e aleatória para assinar o cookie de login
APP_KEY=troque-por-uma-string-aleatoria-longa

# Credenciais de acesso ao sistema
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha
