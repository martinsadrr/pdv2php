# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (porta 6543)
# Formato: postgres://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# Se a senha tiver caracteres especiais (@ : / # ?), codifique-os (ex.: @ vira %40).
DATABASE_URL=postgres://usuario:senha@host:5432/banco
# use "disable" apenas em Postgres local
DB_SSLMODE=require

# Chave longa e aleatória para assinar o cookie de login
APP_KEY=troque-por-uma-string-aleatoria-longa

# Credenciais de acesso ao sistema
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha
